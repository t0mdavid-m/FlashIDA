<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <log4net>
    <appender name="ConsoleAppender" type="log4net.Appender.ColoredConsoleAppender" >
      <mapping>
        <level value="ERROR" />
        <foreColor value="Red" />
        <backColor value="White" />
      </mapping>
      <mapping>
        <level value="WARN" />
        <foreColor value="Yellow" />
      </mapping>
      <mapping>
        <level value="INFO" />
        <foreColor value="White" />
      </mapping>
      <threshold value="INFO" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%8timestamp [%-5level] - %message%newline" />
      </layout>
    </appender>
    <appender name="GeneralFile" type="log4net.Appender.FileAppender" >
      <!-- Flash.Main overwrites this value with an absolute path inside the run folder before
           XmlConfigurator runs. The type="log4net.Util.PatternString" attribute is deliberately
           GONE: the injected value is a literal path, and under PatternString a '%' in it would be
           parsed as a conversion specifier and silently dropped. -->
      <file value="FlashLog.log" />
      <appendToFile value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%8timestamp %message%newline" />
      </layout>
    </appender>
    <appender name="IDAFile" type="log4net.Appender.FileAppender" >
      <!-- Same treatment as GeneralFile. appendToFile is now EXPLICIT: it was absent here, which
           means log4net's default of true, so IDALog appended while its sibling truncated. An
           implicit default that disagrees with the appender next to it is how a run silently ends
           up holding two runs' output. -->
      <file value="IDALog.log" />
      <appendToFile value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%message%newline" />
      </layout>
    </appender>
    <appender name="IDAInfoForward" type="log4net.Appender.ForwardingAppender" >
      <threshold value="INFO" />
      <filter type="log4net.Filter.LevelRangeFilter">
        <levelMin value="INFO" />
        <levelMax value="INFO" />
      </filter>
      <appender-ref ref="ConsoleAppender" />
      <appender-ref ref="GeneralFile" />
    </appender>
    <logger name="General">
      <level value="DEBUG" />
      <appender-ref ref="ConsoleAppender" />
      <appender-ref ref="GeneralFile" />
    </logger>
    <logger name="IDA">
      <level value="DEBUG" />
      <appender-ref ref="IDAFile" />
      <appender-ref ref="IDAInfoForward" />
    </logger>
  </log4net>
</configuration>
