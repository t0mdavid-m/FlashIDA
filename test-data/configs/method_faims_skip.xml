<?xml version="1.0" encoding="utf-8"?>
<MethodParameters xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <GlobalParameter>
    <MethodName>MethodName</MethodName>
    <MethodDescription>Description</MethodDescription>
    <Duration>120</Duration>
  </GlobalParameter>
  <PrecursorSelection>
    <QScoreThreshold>.0</QScoreThreshold>
    <TQScoreThreshold>0.9</TQScoreThreshold>
    <MinCharge>4</MinCharge>
    <MaxCharge>50</MaxCharge>
    <MinMass>500</MinMass>
    <MaxMass>50000</MaxMass>
    <RTWindow>180</RTWindow>
    <HCDEnergy>29</HCDEnergy>
    <Tolerances>
      <double>10</double>
      <double>10</double>
    </Tolerances>
  </PrecursorSelection>
  <AcquisitionModes>
    <TargetingMode>None</TargetingMode>
    <TargetLogs />
    <TargetedInclusion>
      <StrictInclusion>false</StrictInclusion>
      <TieThreshold>0.1</TieThreshold>
      <InclusionList></InclusionList>
      <MS2Tagging>
        <Active>False</Active>
        <ConditionalMS2>false</ConditionalMS2>
        <FastaFile></FastaFile>
        <PtmList></PtmList>
        <MaxPtmCount>3</MaxPtmCount>
        <MinTagLength>3</MinTagLength>
        <MaxTagLength>8</MaxTagLength>
        <MaxFlankingMassDiff>50000</MaxFlankingMassDiff>
      </MS2Tagging>
    </TargetedInclusion>
    <TargetedExclusion />
    <DeepMode />
    <LabelingBasedQuantification>
      <Active>False</Active>
      <ReporterMZTol>2e-3</ReporterMZTol>
      <FoldChangeThreshold>1.4</FoldChangeThreshold>
      <OnlyOneCondition>false</OnlyOneCondition>
    </LabelingBasedQuantification>
    <MS3Characterization>
      <Active>False</Active>
      <MS3Mode>1</MS3Mode>
      <MaxMs3PerMs2>1000</MaxMs3PerMs2>
      <MS3AllCharges>true</MS3AllCharges>
      <MS3ProteinSequence>SEQUENCE</MS3ProteinSequence>
    </MS3Characterization>
    <Developer>
      <PrecursorSelection>
        <UseIDScore>false</UseIDScore>
        <ConsiderAllChargeStates>false</ConsiderAllChargeStates>
      </PrecursorSelection>
      <FAIMS>
        <MaxCVSkip>2</MaxCVSkip>
        <MassThreshold>15</MassThreshold>
      </FAIMS>
    </Developer>
  </AcquisitionModes>
  <MSSettings>
    <MaxMs2CountPerMs1>3</MaxMs2CountPerMs1>
    <FAIMS>
      <CVValues>
        <double>-10</double>
        <double>-30</double>
        <double>-40</double>
        <double>-50</double>
        <double>-60</double>
      </CVValues>
    </FAIMS>
    <MS1>
      <Analyzer>Orbitrap</Analyzer>
      <FirstMass>500</FirstMass>
      <LastMass>2000</LastMass>
      <OrbitrapResolution>120000</OrbitrapResolution>
      <AGCTarget>800000</AGCTarget>
      <MaxIT>246</MaxIT>
      <Microscans>1</Microscans>
      <DataType>Centroid</DataType>
      <RFLens>30</RFLens>
      <SourceCIDScaling>0</SourceCIDScaling>
      <SourceCID>15</SourceCID>
    </MS1>
    <MS2>
      <MS2Parameters>
        <Analyzer>Orbitrap</Analyzer>
        <FirstMass>100</FirstMass>
        <LastMass>2000</LastMass>
        <OrbitrapResolution>120000</OrbitrapResolution>
        <AGCTarget>500000</AGCTarget>
        <MaxIT>100</MaxIT>
        <Microscans>4</Microscans>
        <DataType>Centroid</DataType>
        <Activation>ETD</Activation>
        <ReactionTime>7</ReactionTime>
        <ReagentAGCTarget>700000</ReagentAGCTarget>
        <ReagentMaxIT>200</ReagentMaxIT>
      </MS2Parameters>
    </MS2>
    <MS3>
      <MS3Parameters>
        <Analyzer>Orbitrap</Analyzer>
        <IsolationMode>Quadrupole</IsolationMode>
        <FirstMass>200</FirstMass>
        <LastMass>2000</LastMass>
        <OrbitrapResolution>240000</OrbitrapResolution>
        <AGCTarget>50000000</AGCTarget>
        <MaxIT>500</MaxIT>
        <Microscans>8</Microscans>
        <DataType>Centroid</DataType>
        <Activation>CID</Activation>
        <CollisionEnergy>25</CollisionEnergy>
      </MS3Parameters>
    </MS3>
  </MSSettings>
  <SelectionStrategy>
    <MS1>
      <Selection>qscore</Selection>
      <MaxPrecursors>3</MaxPrecursors>
    </MS1>
    <MS2>
      <Selection>intensity</Selection>
    </MS2>
    <MS3>
      <Selection>none</Selection>
    </MS3>
  </SelectionStrategy>
</MethodParameters>
