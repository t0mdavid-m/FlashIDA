<?xml version="1.0" encoding="utf-8"?>
<MethodParameters xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <GlobalParameter>
    <MethodName>JsonRoundTrip</MethodName>
    <MethodDescription>Phase 1 JSON round-trip test: non-default values, multiple MS2, FAIMS CVs</MethodDescription>
    <Duration>180</Duration>
  </GlobalParameter>

  <PrecursorSelection>
    <QScoreThreshold>0.5</QScoreThreshold>
    <TQScoreThreshold>0.85</TQScoreThreshold>
    <MinCharge>5</MinCharge>
    <MaxCharge>40</MaxCharge>
    <MinMass>600</MinMass>
    <MaxMass>40000</MaxMass>
    <RTWindow>120</RTWindow>
    <Tolerances>
      <double>8</double>
      <double>12</double>
    </Tolerances>
  </PrecursorSelection>

  <AcquisitionModes>
    <TargetingMode>None</TargetingMode>

    <TargetLogs />

    <TargetedInclusion>
      <StrictInclusion>true</StrictInclusion>
      <TieThreshold>0.2</TieThreshold>
      <InclusionList></InclusionList>
      <MS2Tagging>
        <Active>False</Active>
        <ConditionalMS2>false</ConditionalMS2>
        <FastaFile></FastaFile>
        <PtmList></PtmList>
        <MaxPtmCount>5</MaxPtmCount>
        <MinTagLength>4</MinTagLength>
        <MaxTagLength>10</MaxTagLength>
        <MaxFlankingMassDiff>40000</MaxFlankingMassDiff>
      </MS2Tagging>
    </TargetedInclusion>

    <TargetedExclusion>
    </TargetedExclusion>

    <DeepMode>
    </DeepMode>

    <LabelingBasedQuantification>
      <Active>False</Active>
      <ReporterMZTol>3e-3</ReporterMZTol>
      <FoldChangeThreshold>2.0</FoldChangeThreshold>
      <OnlyOneCondition>true</OnlyOneCondition>
    </LabelingBasedQuantification>

    <MS3Characterization>
      <Active>False</Active>
      <MS3Mode>2</MS3Mode>
      <MaxMs3PerMs2>500</MaxMs3PerMs2>
      <MS3AllCharges>false</MS3AllCharges>
      <MS3ProteinSequence>TESTSEQUENCE</MS3ProteinSequence>
    </MS3Characterization>

    <Developer>
      <PrecursorSelection>
        <UseIDScore>true</UseIDScore>
        <ConsiderAllChargeStates>true</ConsiderAllChargeStates>
        <HCDEnergy>35</HCDEnergy>
      </PrecursorSelection>
      <FAIMS>
        <MaxCVSkip>2</MaxCVSkip>
        <MassThreshold>20</MassThreshold>
      </FAIMS>
    </Developer>
  </AcquisitionModes>

  <MSSettings>
    <MaxMs2CountPerMs1>3</MaxMs2CountPerMs1>
    <FAIMS>
      <CVValues>
        <double>-40</double>
        <double>-50</double>
        <double>-60</double>
      </CVValues>
    </FAIMS>
    <MS1>
      <Analyzer>Orbitrap</Analyzer>
      <FirstMass>400</FirstMass>
      <LastMass>2500</LastMass>
      <OrbitrapResolution>240000</OrbitrapResolution>
      <AGCTarget>1000000</AGCTarget>
      <MaxIT>300</MaxIT>
      <Microscans>2</Microscans>
      <DataType>Centroid</DataType>
      <RFLens>35</RFLens>
      <SourceCIDScaling>0</SourceCIDScaling>
      <SourceCID>20</SourceCID>
    </MS1>
    <MS2>
      <MS2Parameters>
        <Analyzer>Orbitrap</Analyzer>
        <FirstMass>150</FirstMass>
        <LastMass>2500</LastMass>
        <OrbitrapResolution>120000</OrbitrapResolution>
        <AGCTarget>500000</AGCTarget>
        <MaxIT>150</MaxIT>
        <Microscans>4</Microscans>
        <DataType>Centroid</DataType>
        <Activation>HCD</Activation>
        <CollisionEnergy>35</CollisionEnergy>
      </MS2Parameters>
      <MS2Parameters>
        <Analyzer>Orbitrap</Analyzer>
        <FirstMass>100</FirstMass>
        <LastMass>2000</LastMass>
        <OrbitrapResolution>60000</OrbitrapResolution>
        <AGCTarget>300000</AGCTarget>
        <MaxIT>100</MaxIT>
        <Microscans>2</Microscans>
        <DataType>Centroid</DataType>
        <Activation>ETD</Activation>
        <ReactionTime>10</ReactionTime>
        <ReagentAGCTarget>700000</ReagentAGCTarget>
        <ReagentMaxIT>200</ReagentMaxIT>
      </MS2Parameters>
    </MS2>
    <MS3>
      <MS3Parameters>
        <Analyzer>Orbitrap</Analyzer>
        <IsolationMode>Quadrupole</IsolationMode>
        <FirstMass>200</FirstMass>
        <LastMass>2000</LastMass>
        <OrbitrapResolution>240000</OrbitrapResolution>
        <AGCTarget>50000000</AGCTarget>
        <MaxIT>500</MaxIT>
        <Microscans>8</Microscans>
        <DataType>Centroid</DataType>
        <Activation>CID</Activation>
        <CollisionEnergy>30</CollisionEnergy>
      </MS3Parameters>
    </MS3>
  </MSSettings>
  <SelectionStrategy>
    <MS1>
      <Selection>qscore</Selection>
      <MaxPrecursors>3</MaxPrecursors>
    </MS1>
    <MS2>
      <Selection>intensity</Selection>
    </MS2>
    <MS3>
      <Selection>none</Selection>
    </MS3>
  </SelectionStrategy>
</MethodParameters>
